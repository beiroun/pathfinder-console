{
  "name": "pathfinder-console",
  "version": "0.0.0-dev",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Management console of Pathfinder, the device-aware QR redirect service",
  "repository": "github:beiroun/pathfinder-console",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "axios": "1.20.0",
    "js-cookie": "3.0.8",
    "jwt-decode": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/js-cookie": "3.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
